FROM node:24.12.0-alpine AS frontend-build

WORKDIR /frontend

RUN corepack enable

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY env.d.ts index.html tsconfig*.json vite.config.ts ./
COPY public ./public
COPY src ./src
RUN pnpm build

FROM eclipse-temurin:21-jdk-alpine AS backend-build

WORKDIR /backend

COPY backend/gradlew backend/settings.gradle.kts backend/build.gradle.kts ./
COPY backend/gradle ./gradle
RUN chmod +x gradlew && ./gradlew dependencies --no-daemon >/dev/null

COPY backend/src ./src
COPY --from=frontend-build /frontend/dist ./src/main/resources/static
RUN ./gradlew test bootJar --no-daemon

FROM eclipse-temurin:21-jre-alpine

ARG VCS_REF=unknown

LABEL org.opencontainers.image.source="https://github.com/HCHJEONG/vueshines" \
      org.opencontainers.image.revision="$VCS_REF"

WORKDIR /app

RUN addgroup -S spring && adduser -S spring -G spring

COPY --from=backend-build --chown=spring:spring /backend/build/libs/*.jar app.jar

USER spring:spring

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=3s --start-period=20s --retries=6 \
  CMD wget --quiet --spider http://localhost:8080/api/health || exit 1

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
